[package]
name = "blinfy"
version = "1.0.0"
description = "Blinfy desktop music player"
edition = "2021"

[lib]
name = "blinfy_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
tauri = { version = "2", features = [] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
